# Optional. Keep the real value in the Ubuntu service environment or a local
# secret manager. Never commit a real key or put it in the Web/App bundle.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ROS 2 host settings
EDGE_ROS_ENABLE=1
ROS_DOMAIN_ID=40
